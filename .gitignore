# Everything under bin/ is build output: Windows binaries (.exe/.dll/.obj/...),
# Linux extensionless binaries (dmrcrack, test_*), GPU tuning cfg, runtime .ini,
# and capture sessions. Only the tracked app manifest is kept.
bin/*
!bin/dmrcrack.exe.manifest

# CUDA intermediate files
*.o
*.ptx
*.cubin
*.fatbin

# MSVC build artifacts
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.res

# Installer output
installer/output/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Test data (may contain captured radio traffic — do not publish)
test/

# DSD-FME DSP dumps (raw captured traffic / debug fixtures — do not publish)
DSP/
*.dsdsp.txt

# Live-capture session output (runtime; may contain intercepted traffic — do not publish)
captures/

# Paper / research write-up (kept private — do not publish)
paper/

# Claude Code
.claude/settings.local.json

# Temporary build scripts and logs
run_build.ps1
build_output.txt
_build_tmp.bat

# Editor / IDE
.vs/
*.suo
*.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
.idea/
*.swp
*.swo
*~

# Claude Code internal files and AI planning artifacts
CLAUDE.md
docs/plans/
**/plans/*.md
Mejora.md

# DSD-FME runtime (binaries — run tools/get_runtime.bat to download)
tools/*.dll
tools/*.exe

# Environment / secrets
.env
.env.*
!.env.example
*.pem
eddsa_priv.key

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Project website (not hosted on GitHub)
web/

# Build output directories (compiled artifacts, not tracked)
bin/Release/
build_cl/

# Local preview / launch config (per-machine dev tooling)
.claude/launch.json
build_verify.log
