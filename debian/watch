version=4

# Upstream tarballs are repacked (+dfsg) to drop the prebuilt Windows-only
# WinSparkle binaries (vendor/winsparkle/*.dll, *.lib, *.exe); see the
# Files-Excluded field in debian/copyright.
opts="repacksuffix=+dfsg,dversionmangle=auto,\
filenamemangle=s%(?:.*?)?v?(\d[\d.]*)\.tar\.gz%dmrcrack-$1.tar.gz%" \
  https://github.com/FSP-Labs/FSP.DMRCrack/tags \
  (?:.*?/)?v?(\d[\d.]+)\.tar\.gz debian uupdate
